{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risu.e2-observability-overlay/v0.1",
  "type": "object",
  "required": [
    "schema",
    "semantic_authority",
    "base_ir_schema",
    "base_ir_digest_sha256",
    "consequence_anchor_contract_sha256",
    "files",
    "frontend_status",
    "control_completeness",
    "definition_state_semantics",
    "binding_slots",
    "nodes",
    "edges",
    "implementation_claim_boundary",
    "overlay_digest_sha256"
  ],
  "properties": {
    "schema": {"const": "risu.e2-observability-overlay/v0.1"},
    "semantic_authority": {"const": false},
    "base_ir_schema": {"const": "risu.e2-normalized-semantic-flow-ir/v0.1"},
    "base_ir_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "consequence_anchor_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {"type": "array", "minItems": 1},
    "frontend_status": {"type": "array", "minItems": 1},
    "control_completeness": {"type": "array", "minItems": 1},
    "definition_state_semantics": {"type": "object"},
    "binding_slots": {"type": "object"},
    "nodes": {"type": "array"},
    "edges": {"type": "array"},
    "implementation_claim_boundary": {"const": "D1_D2_D3_OBSERVABILITY_ONLY_NO_A3_A4_VERDICT"},
    "overlay_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
